{
  "name": "@nook-dsh/ui-knowledge",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "dependencies": {
    "@nook-dsh/adapter-knowledge-dsh": "workspace:*",
    "@nook-dsh/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.3-alpha.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-agent": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.3-alpha.2"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
