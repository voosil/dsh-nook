{
  "name": "@nook-dsh/adapter-browser-community",
  "version": "0.1.0",
  "description": "Adapter from dsh-browser-playwright's public service to the Nook browser capability",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@nook-dsh/capability-browser": "workspace:*",
    "dsh-browser-playwright": "0.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  }
}
