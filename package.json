{
  "name": "nook-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "Nook: a standalone product profile composed from DeepSeek Harness plugins",
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "sync-server:package": "node scripts/sync-server/package.mjs",
    "sync-server:verify": "node scripts/test/run.mjs sync-server",
    "build": "tsc -b --pretty false && tsc --noEmit -p apps/desktop/tsconfig.json --pretty false && node scripts/build/build-client.mjs && node scripts/build/build-desktop.mjs",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p apps/desktop/tsconfig.json --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test/run.mjs all",
    "test:integration": "node scripts/test/run.mjs integration",
    "test:e2e": "node scripts/test/run.mjs e2e",
    "dev": "node scripts/profile/run-profile.mjs",
    "dev:seed": "node scripts/profile/run-profile.mjs --seed",
    "dev:clean": "node scripts/profile/run-profile.mjs --clean",
    "start": "node scripts/profile/start-profile.mjs",
    "start:app": "open .pack/desktop/mac-arm64/Nook.app",
    "dev:safe-ui": "node scripts/profile/run-profile.mjs --safe-ui",
    "dev:profile": "node scripts/profile/dev-profile.mjs",
    "verify:profile": "node scripts/verify/verify-profile.mjs",
    "verify:boundaries": "node scripts/verify/verify-boundaries.mjs",
    "lint:css": "stylelint \"packages/ui-*/src/**/*.css\" \"packages/ui-kit/styles/**/*.css\"",
    "verify:ui-tokens": "node scripts/verify/verify-ui-tokens.mjs",
    "verify:package": "node scripts/verify/verify-package.mjs",
    "docs:check": "node scripts/verify/check-docs.mjs",
    "verify": "node scripts/verify/verify.mjs",
    "verify:peers": "node scripts/verify/verify-peers.mjs",
    "backup": "node --import tsx scripts/data/data-backup.mjs",
    "desktop:dev": "node scripts/desktop/run-desktop.mjs",
    "desktop:stage": "pnpm run build && node scripts/desktop/stage-desktop.mjs",
    "desktop:package": "node scripts/desktop/package-desktop.mjs",
    "verify:desktop": "node scripts/verify/verify-desktop.mjs",
    "verify:windows": "node scripts/verify/verify-windows-start.mjs",
    "test:unit": "node scripts/test/run.mjs unit",
    "test:component": "node scripts/test/run.mjs component"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/node": "24.10.2",
    "@types/react": "18.3.31",
    "dsh-browser-playwright": "0.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-agent": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.3-alpha.2",
    "@types/react-dom": "18.3.7",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.3-alpha.2"
  }
}
